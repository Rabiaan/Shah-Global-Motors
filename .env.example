# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------- Database Credentials (Live Database) ----------
# Used by public/api/config.php. Replace with your cPanel MySQL details.
DB_HOST="localhost"
DB_NAME="shahglobal_db"
DB_USER="shahglobal_user"
DB_PASS="YOUR_SECURE_DB_PASSWORD"

# ---------- Admin Login Credentials (Live Admin Panel) ----------
# Used by public/api/auth.php as the demo fallback admin.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@shahglobal.com"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"
ADMIN_ROLE="Super Admin"
ADMIN_DISPLAY_NAME="Shahglobal Senior Executive"
