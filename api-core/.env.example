# ==========================================================
# api-core environment template
# Copy to .env and fill in values. NEVER commit .env.
# ==========================================================

# ---- Database (MySQL / MariaDB) ----
DB_HOST="localhost"
DB_NAME="shahglobal_db"
DB_USER="shahglobal_user"
DB_PASS="YourStrongPassword123!"
DB_CHARSET="utf8mb4"

# ---- App ----
# The exact origin(s) the API is allowed to serve. Comma-separated.
# Requests not matching this origin are rejected (403). DO NOT use "*".
ALLOWED_ORIGINS="https://your-frontend-domain.com"
APP_URL="https://your-frontend-domain.com"
APP_ENV="production"            # production | staging | development
APP_DEBUG="false"               # NEVER true in production

# ---- JWT Auth ----
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET="CHANGE_ME_64_hex_chars_generated_by_random_bytes"
JWT_ISSUER="shahglobal"
JWT_AUDIENCE="shahglobal-api"
JWT_TTL_SECONDS="3600"          # access token lifetime (1h)

# ---- Password Reset ----
# Link/token expiry in seconds (1800 = 30 minutes)
PASSWORD_RESET_TTL_SECONDS="1800"

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"    # per window per client
RATE_LIMIT_AUTH_MAX="10"         # stricter for login/reset endpoints

# ---- Logging & Alerts ----
LOG_DIRECTORY="./storage/logs"
LOG_LEVEL="error"                # debug | info | warning | error | critical
# Webhook (Slack/Discord/email API) called on CRITICAL log entries.
# Leave empty to disable remote alerts.
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_HMAC_SECRET=""     # optional shared secret to sign alert payloads
