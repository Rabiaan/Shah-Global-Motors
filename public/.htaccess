# Shah Global Motors - SPA history fallback
# Rewrites all non-file, non-API requests to index.html so client-side
# path routing (/new-cars, /used-cars, etc.) works on Apache/cPanel.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to real files/folders (assets, images, php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Do NOT rewrite /api/* - let the PHP backend handle those
    RewriteRule ^api(/|$) - [L]

    # Everything else -> index.html
    RewriteRule . index.html [L]
</IfModule>
